---
import '../styles/global.css';

const projects = [
  {
    number: '01',
    kind: 'CLINIC WORKFLOWS',
    title: 'Electronic Health Records (EHR)',
    status: 'DEMO',
    statusClass: 'dev',
    description: 'Clinic EHR prototype for patient charts, appointment scheduling, QR check-in queues, visit notes and printable prescription drafts. A React + TypeScript demo with a PostgreSQL schema, Docker Compose environment and automated CI checks.',
    stack: ['React', 'TypeScript', 'PostgreSQL', 'Docker Compose', 'GitHub Actions'],
    image: '/projects/ehr-homepage.png',
    imageAlt: 'Northstar Clinic EHR dashboard showing patient counts, appointments and clinic flow with sample records',
    repoHref: 'https://github.com/trycharoo/Internal-Clinic-Web-app',
  },
  {
    number: '02',
    kind: 'FLOWER STOREFRONT',
    title: 'Kim Flower Shop',
    status: 'PROJECT',
    statusClass: '',
    description: 'Responsive flower shop storefront with a Sanity-managed product catalog, sale pricing and customizable branding. Built with Astro and Tailwind CSS, with an embedded Sanity Studio for managing products, announcements and site content.',
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Sanity CMS'],
    image: '/projects/flower-shop-homepage.png',
    imageAlt: 'Kim Flower Shop homepage with Make room for flowers headline, navigation and floral hero artwork',
    repoHref: 'https://github.com/dJangg0/kim-flower-shop',
  },
  {
    number: '03',
    kind: 'CASHLESS CAMPUS',
    title: 'Online Coop',
    status: 'LIVE',
    statusClass: 'live',
    description: 'Digital payment + transaction system for a school cafeteria. Secure admin dashboard for sales tracking, student balances and cashless checkout.',
    stack: ['Node.js', 'React', 'TypeScript', 'Firebase', 'OAuth'],
    image: '/coop.png',
  },
  {
    number: '04',
    kind: 'CYBERSECURITY LAB',
    title: 'Hackafest Vulnerable Web App',
    status: 'LIVE',
    statusClass: 'live',
    description: 'Deliberately vulnerable practice ground for web exploitation + CTF prep. Built for Hack4Gov aspirants to learn by breaking legally.',
    stack: ['Web security', 'CTF', 'Full-stack'],
    image: '/hack1.png',
  },
  {
    number: '05',
    kind: 'CROSS-PLATFORM APP',
    title: 'Thribo Screening Tool',
    status: 'LIVE',
    statusClass: 'live',
    description: 'Responsive screening + assessment tool across mobile and web. Streamlines applicant evaluation. Access: thribo-app.web.app',
    stack: ['Ionic React', 'Node.js', 'TypeScript', 'Tailwind'],
    image: '/ojt1.png',
    href: 'https://thribo-app.web.app/',
  },
  {
    number: '06',
    kind: 'CONNECTED SYSTEMS',
    title: 'Live Electrical Monitor',
    status: 'DEV',
    statusClass: 'dev',
    description: 'Real-time voltage / current / temperature monitoring. Socket-driven live UI with sound alerts for overvoltage and thermal spikes.',
    stack: ['Node.js', 'WebSockets', 'Realtime UI', 'IoT'],
    image: '/ppe.png',
  },
  {
    number: '07',
    kind: 'LOCATION-AWARE HEALTH',
    title: 'AbTech Emergency Response',
    status: 'TOP 10',
    statusClass: 'live',
    description: 'Single-tap emergency locator + daily screening companion with Drive Mode crash detection and Dijkstra-routed responder dispatch.',
    stack: ['Geospatial', 'Routing', 'Mobile', 'Health tech'],
    image: '/h4h1.jpg',
  },
  {
    number: '08',
    kind: 'AI / MOBILE',
    title: 'ASL Interpreter Prototype',
    status: 'R&D',
    statusClass: 'dev',
    description: 'Mobile ASL interpretation prototype using CNNs + TensorFlow Lite to process video on-device and bridge communication gaps.',
    stack: ['Python', 'TensorFlow Lite', 'CNN', 'MediaPipe'],
    image: '/imgg.jpg',
  },
];

const kits = [
  { label: 'Languages', values: ['TypeScript', 'JavaScript', 'Python', 'Java', 'Kotlin', 'SQL', 'HTML5', 'CSS3'] },
  { label: 'Web & Mobile', values: ['React', 'Astro', 'Ionic React', 'Node.js', 'Tailwind CSS', 'Sanity CMS', 'Android Studio'] },
  { label: 'DevOps & Delivery', values: ['Docker', 'Docker Compose', 'GitHub Actions', 'CI/CD', 'Git', 'Linux'] },
  { label: 'AI & Tools', values: ['TensorFlow Lite', 'CNN Models', 'MediaPipe', 'FFmpeg'] },
  { label: 'Security', values: ['Kali Linux', 'Nmap', 'Wireshark', 'OSINT', 'Burp-style testing'] },
  { label: 'Data & Realtime', values: ['Firebase', 'PostgreSQL', 'MySQL', 'Supabase', 'WebSockets', 'Redis'] },
  { label: 'CTF & Teams', values: ['Hack4Gov', 'Hack4Health', 'TryHackMe-style labs', 'Rapid prototyping'] },
];

const wins = [
  { ix: '01', nm: 'Hack4Gov 3 — Region VI Champion', ds: 'Led ISAT U team · day-long CTF · July 16, 2024' },
  { ix: '02', nm: 'DOH Hack4Health — Top 10 National Finalist', ds: 'AbTech emergency response · DAP Tagaytay' },
  { ix: '03', nm: 'Full-stack + IoT builds shipped', ds: 'Coop payments · electrical monitor · Thribo app' },
  { ix: '04', nm: 'AI prototype for accessibility', ds: 'On-device ASL interpretation · CNN + TFLite' },
  { ix: '05', nm: 'Clinic workflows + content-driven storefronts', ds: 'EHR prototype · Kim Flower Shop · Docker + CI pipelines' },
];
