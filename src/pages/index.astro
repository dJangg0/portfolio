<script>
import { initIloiloMap } from '../scripts/iloilo-map.js';

(function(){
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePtr = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* scramble */
  const GL = '!<>-_\\/[]{}=+*^?#%$01';
  function scramble(el, txt, dur){
    if(reduce){ el.textContent = txt; return; }
    dur = dur || 420;
    const st = performance.now(), len = txt.length;
    if(el._r) cancelAnimationFrame(el._r);
    const step = (t) => {
      const k = Math.min(1,(t-st)/dur), fx = Math.floor(k*len);
      let o=''; for(let i=0;i<len;i++){ const c=txt[i]; o += (i<fx||c===' ') ? c : GL[(Math.random()*GL.length)|0]; }
      el.textContent = o;
      if(k<1) el._r = requestAnimationFrame(step); else el.textContent = txt;
    };
    el._r = requestAnimationFrame(step);
  }
  document.querySelectorAll('[data-scramble]').forEach((el)=>{
    const txt = el.textContent;
    el.addEventListener('mouseenter',()=>scramble(el,txt,360));
    el.addEventListener('focus',()=>scramble(el,txt,360));
  });

  /* rotating role */
  const roles = ['Full-stack software developer','DevOps engineer','Web + mobile application builder','Real-time systems builder','Hack4Gov Region VI champion','Hack4Health Top 10 finalist'];
  const roleEl = document.getElementById('role');
  let ri = 0;
  if(!reduce && roleEl){ setInterval(()=>{ ri=(ri+1)%roles.length; scramble(roleEl, roles[ri], 700); }, 3200); }

  /* glitch bursts + tears */
  const glitchEls = [...document.querySelectorAll('.glitch')];
  function burst(el){ el.classList.remove('burst'); void el.offsetWidth; el.classList.add('burst'); setTimeout(()=>el.classList.remove('burst'),450); }
  glitchEls.forEach((el)=>{ if(!el.classList.contains('idle')) el.addEventListener('mouseenter',()=>burst(el)); });
  const tear = document.querySelector('.tear');
  function pageTear(){
    if(!tear) return;
    tear.innerHTML='';
    const n = 3 + (Math.random()*4|0);
    for(let i=0;i<n;i++){ const b=document.createElement('i'); b.style.top=(Math.random()*100)+'%'; b.style.height=(2+Math.random()*14)+'px'; tear.appendChild(b); }
    document.body.classList.add('tearing');
    setTimeout(()=>document.body.classList.remove('tearing'),260);
  }
  const op = document.getElementById('op');
  function loop(){
    const delay = 3500 + Math.random()*5000;
    setTimeout(()=>{
      if(!document.hidden){
        const vis = glitchEls.filter((e)=>{const r=e.getBoundingClientRect();return r.bottom>0&&r.top<innerHeight;});
        if(vis.length) burst(vis[(Math.random()*vis.length)|0]);
        const roll = Math.random();
        if(roll<.35) pageTear();
        else if(roll<.55 && op){ op.classList.add('burst'); setTimeout(()=>op.classList.remove('burst'),420); }
      }
      loop();
    }, delay);
  }
  if(!reduce){ setTimeout(pageTear, 500); loop(); }

  /* spotlight */
  const spot = document.querySelector('.fx-spot');
  const ptr = {x: innerWidth*.7, y: innerHeight*.15, on:false};
  addEventListener('pointermove', (e)=>{
    ptr.x=e.clientX; ptr.y=e.clientY; ptr.on=e.pointerType==='mouse';
    if(spot){ spot.style.setProperty('--mx', e.clientX+'px'); spot.style.setProperty('--my', e.clientY+'px'); }
    const s = e.target.closest && e.target.closest('[data-spot]');
    if(s){ const r=s.getBoundingClientRect(); s.style.setProperty('--x',(e.clientX-r.left)+'px'); s.style.setProperty('--y',(e.clientY-r.top)+'px'); }
  }, {passive:true});

  /* network canvas */
  const net = document.querySelector('.fx-net');
  const nx = net.getContext('2d');
  let W=0,H=0,nodes=[],packets=[],nextPacket=0;
  function sizeNet(){
    W = net.width = innerWidth; H = net.height = innerHeight;
    const n = Math.max(22, Math.min(72, Math.round(W*H/23000)));
    nodes = Array.from({length:n}, ()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*1.3+.6}));
    packets=[];
  }
  sizeNet(); addEventListener('resize', sizeNet);
  const LINK=135, LINK2=LINK*LINK;
  function drawNet(t){
    nx.clearRect(0,0,W,H);
    for(const n of nodes){
      if(ptr.on){ const dx=ptr.x-n.x, dy=ptr.y-n.y, d=Math.hypot(dx,dy); if(d<220&&d>1){ n.vx+=dx/d*.01; n.vy+=dy/d*.01; } }
      const sp=Math.hypot(n.vx,n.vy);
      if(sp>.85){n.vx*=.92;n.vy*=.92;} else if(sp<.12){n.vx*=1.06;n.vy*=1.06;}
      n.x+=n.vx; n.y+=n.vy;
      if(n.x<-20)n.x=W+20; else if(n.x>W+20)n.x=-20;
      if(n.y<-20)n.y=H+20; else if(n.y>H+20)n.y=-20;
    }
    nx.lineWidth=1;
    for(let i=0;i<nodes.length;i++){ const a=nodes[i];
      for(let j=i+1;j<nodes.length;j++){ const b=nodes[j], dx=a.x-b.x, dy=a.y-b.y, d2=dx*dx+dy*dy;
        if(d2<LINK2){ nx.strokeStyle='rgba(0,255,102,'+((1-Math.sqrt(d2)/LINK)*.26).toFixed(3)+')'; nx.beginPath(); nx.moveTo(a.x,a.y); nx.lineTo(b.x,b.y); nx.stroke(); } } }
    nx.fillStyle='rgba(52,255,120,.75)';
    for(const n of nodes){ nx.beginPath(); nx.arc(n.x,n.y,n.r,0,6.283); nx.fill(); }
    if(t>nextPacket){
      nextPacket=t+260+Math.random()*420;
      const a=(Math.random()*nodes.length)|0;
      for(let k=0;k<nodes.length;k++){ const b=(a+1+k)%nodes.length, dx=nodes[a].x-nodes[b].x, dy=nodes[a].y-nodes[b].y;
        if(dx*dx+dy*dy<LINK2){ packets.push({a,b,t0:t,dur:700+Math.random()*600,c:Math.random()<.2}); break; } }
    }
    packets=packets.filter((p)=>{
      const k=(t-p.t0)/p.dur; if(k>=1) return false;
      const A=nodes[p.a],B=nodes[p.b];
      const x=A.x+(B.x-A.x)*k, y=A.y+(B.y-A.y)*k;
      nx.fillStyle=p.c?'rgba(143,246,255,.22)':'rgba(0,255,102,.25)'; nx.beginPath(); nx.arc(x,y,4.5,0,6.283); nx.fill();
      nx.fillStyle=p.c?'#d6ffe2':'#7dff9e'; nx.beginPath(); nx.arc(x,y,1.7,0,6.283); nx.fill();
      return true;
    });
  }

  /* cursor */
  const ring=document.querySelector('.cur-ring'), dot=document.querySelector('.cur-dot');
  const useCur = finePtr && !reduce;
  let rx=ptr.x, ry=ptr.y;
  if(useCur){
    addEventListener('pointermove',(e)=>{ if(e.pointerType==='mouse') document.body.classList.add('has-cur'); },{passive:true});
    document.addEventListener('pointerover',(e)=>{
      const hot=e.target.closest && e.target.closest('a,button,.chip,.card,.cert,.kit,.op,.shot');
      if(ring) ring.classList.toggle('hot', !!hot);
    });
  }
  function moveCur(){
    if(!useCur) return;
    rx+=(ptr.x-rx)*.2; ry+=(ptr.y-ry)*.2;
    if(ring) ring.style.transform='translate3d('+rx+'px,'+ry+'px,0)';
    if(dot) dot.style.transform='translate3d('+ptr.x+'px,'+ptr.y+'px,0)';
  }
  function bgLoop(t){ drawNet(t||0); moveCur(); requestAnimationFrame(bgLoop); }
  if(reduce) drawNet(0); else requestAnimationFrame(bgLoop);

  /* click bursts */
  const top=document.querySelector('.fx-top'), tx=top.getContext('2d');
  let parts=[], rings=[], topRun=false;
  function sizeTop(){ const d=Math.min(devicePixelRatio||1,2); top.width=innerWidth*d; top.height=innerHeight*d; tx.setTransform(d,0,0,d,0,0); }
  sizeTop(); addEventListener('resize', sizeTop);
  function burstAt(x,y){
    for(let i=0;i<16;i++){ const a=Math.random()*6.283, s=1.6+Math.random()*4.2;
      parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:420+Math.random()*420,t0:performance.now(),c:Math.random()<.22}); }
    rings.push({x,y,t0:performance.now()});
    if(!topRun){ topRun=true; requestAnimationFrame(topLoop); }
  }
  function topLoop(t){
    tx.clearRect(0,0,innerWidth,innerHeight);
    rings=rings.filter((r)=>{ const k=(t-r.t0)/520; if(k>=1) return false;
      tx.strokeStyle='rgba(0,255,102,'+(1-k)*.9+')'; tx.lineWidth=1.5;
      tx.beginPath(); tx.arc(r.x,r.y,6+k*46,0,6.283); tx.stroke(); return true; });
    parts=parts.filter((p)=>{ const k=(t-p.t0)/p.life; if(k>=1) return false;
      p.x+=p.vx; p.y+=p.vy; p.vx*=.93; p.vy*=.93;
      tx.strokeStyle=p.c?'rgba(143,246,255,'+(1-k)+')':'rgba(0,230,90,'+(1-k)+')'; tx.lineWidth=1.6;
      tx.beginPath(); tx.moveTo(p.x,p.y); tx.lineTo(p.x-p.vx*4,p.y-p.vy*4); tx.stroke(); return true; });
    if(parts.length||rings.length) requestAnimationFrame(topLoop);
    else { topRun=false; tx.clearRect(0,0,innerWidth,innerHeight); }
  }
  addEventListener('pointerdown',(e)=>{
    if(useCur && ring) ring.classList.add('press');
    if(reduce) return;
    burstAt(e.clientX, e.clientY);
    const z=e.target.closest && e.target.closest('a,button,.chip,.cert,.tag');
    if(z){ z.classList.remove('zap'); void z.offsetWidth; z.classList.add('zap'); setTimeout(()=>z.classList.remove('zap'),380); }
  },{passive:true});
  addEventListener('pointerup',()=>{ if(useCur && ring) ring.classList.remove('press'); });

  /* tilt */
  if(finePtr && !reduce){
    document.querySelectorAll('[data-tilt]').forEach((el)=>{
      const max=+el.dataset.tilt||6;
      el.addEventListener('pointermove',(e)=>{
        if(e.pointerType!=='mouse') return;
        const r=el.getBoundingClientRect(), px=(e.clientX-r.left)/r.width-.5, py=(e.clientY-r.top)/r.height-.5;
        const card = el.closest('.card') || el;
        el.style.setProperty('--ry',(px*max).toFixed(2)+'deg');
        el.style.setProperty('--rx',(-py*max).toFixed(2)+'deg');
      });
      el.addEventListener('pointerleave',()=>{ el.style.setProperty('--rx','0deg'); el.style.setProperty('--ry','0deg'); });
    });
  }

  /* nav + progress */
  const nav=document.querySelector('.nav'), ind=document.querySelector('.nav-ind'), bar=document.querySelector('.scrollbar span');
  function moveInd(){
    if(!nav || !ind) return;
    const a=nav.querySelector('a.on');
    if(!a){ ind.style.width='0px'; return; }
    ind.style.width=(a.offsetWidth-12)+'px';
    ind.style.transform='translateX('+(a.offsetLeft+6)+'px)';
  }
  const links=[...document.querySelectorAll('.nav a')];
  const secs=links.map((a)=>document.querySelector(a.getAttribute('href')));
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver((es)=>{ es.forEach((en)=>{ if(en.isIntersecting){ links.forEach((a)=>a.classList.toggle('on', a.getAttribute('href')==='#'+en.target.id)); moveInd(); } }); },{rootMargin:'-45% 0px -50% 0px'});
    secs.forEach((s)=>s&&io.observe(s));
  }
  new MutationObserver(moveInd).observe(nav,{subtree:true,attributes:true,attributeFilter:['class']});
  moveInd(); if(document.fonts && document.fonts.ready) document.fonts.ready.then(moveInd);
  addEventListener('resize', moveInd);
  let sTick=false;
  addEventListener('scroll',()=>{
    if(sTick) return; sTick=true;
    requestAnimationFrame(()=>{
      const max=document.documentElement.scrollHeight-innerHeight;
      if(bar) bar.style.setProperty('--p', max>0 ? (scrollY/max).toFixed(4) : 0);
      sTick=false;
    });
  },{passive:true});

  /* reveal */
  if('IntersectionObserver' in window && !reduce){
    const els=[...document.querySelectorAll('.sec-head,.about-copy > *,.base-card,.card,.record,.certs,.kit')];
    const io=new IntersectionObserver((es)=>es.forEach((en)=>{
      if(!en.isIntersecting) return;
      const el=en.target; io.unobserve(el);
      el.classList.remove('pre');
      const h=el.classList.contains('sec-head') && el.querySelector('h2');
      if(h) setTimeout(()=>scramble(h,h.textContent,650),120);
      setTimeout(()=>{ el.classList.remove('rv'); el.style.removeProperty('--d'); },900);
    }),{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    els.forEach((el)=>{
      const r=el.getBoundingClientRect();
      if(r.top<innerHeight*.95) return;
      const idx=[...el.parentElement.children].indexOf(el);
      el.style.setProperty('--d', Math.min(idx,5)*90+'ms');
      el.classList.add('rv','pre'); io.observe(el);
    });
  }

  initIloiloMap();

  /* lightbox */
  const box=document.getElementById('shotBox'), boxImg=document.getElementById('boxImg'), boxCap=document.getElementById('boxCap');
  document.querySelectorAll('.shot-open').forEach((b)=>{
    b.addEventListener('click',()=>{
      const src=b.getAttribute('data-full'), title=b.getAttribute('data-title');
      if(boxImg){ boxImg.src=src; boxImg.alt=title || 'project preview'; }
      if(boxCap) boxCap.textContent=title || 'preview';
      if(typeof box.showModal==='function') box.showModal(); else box.setAttribute('open','');
    });
  });
  const closeBtn=document.getElementById('boxClose');
  if(closeBtn) closeBtn.addEventListener('click',()=>{ if(box.open) box.close(); });
  if(box) box.addEventListener('click',(e)=>{ if(e.target===box) box.close(); });
})();
</script>
</body>
</html>
